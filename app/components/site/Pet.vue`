<script setup lang="ts">
import { ref, onMounted, onUnmounted } from 'vue'

const posX = ref(0)
const posY = ref(0)
const bob = ref(0)
const emotion = ref('happy')

// Bounciness and Tricks state
const scaleX = ref(1)
const scaleY = ref(1)
const trickRotation = ref(0)
const trickJump = ref(0)
const currentTrick = ref<'none' | 'flip' | 'jump'>('none')
const trickProgress = ref(0)

let lastX = 0
let lastY = 0
let animationFrameId: number | null = null
let emotionTimer: any = null

const emotions = ['happy', 'surprised', 'blink', 'excited']

function update() {
  const now = performance.now()

  const dx = lastX - posX.value
  const dy = lastY - posY.value
  const dist = Math.sqrt(dx * dx + dy * dy)

  // 1. Movement Logic
  if (dist > 300) {
    emotion.value = 'angry'
    posX.value += dx * 0.03
    posY.value += dy * 0.03
  } else if (dist > 120) {
    if (Math.random() < 0.005) changeEmotion()
    posX.value += dx * 0.03
    posY.value += dy * 0.03
  } else {
    if (Math.random() < 0.005) changeEmotion()

    // Randomly trigger tricks while playing
    if (currentTrick.value === 'none' && Math.random() < 0.002) {
      currentTrick.value = Math.random() > 0.5 ? 'flip' : 'jump'
      trickProgress.value = 0
    }

    const orbitRadius = 40
    const orbitSpeed = now / 1200
    const targetX = lastX + Math.cos(orbitSpeed) * orbitRadius
    const targetY = lastY + Math.sin(orbitSpeed) * orbitRadius

    posX.value += (targetX - posX.value) * 0.03
    posY.value += (targetY - posY.value) * 0.03
  }

  // 2. Bounciness (Squash and Stretch)
  const bounceFactor = Math.sin(now / 400)
  bob.value = bounceFactor * 5
  scaleX.value = 1 - bounceFactor * 0.05
  scaleY.value = 1 + bounceFactor * 0.05

  // 3. Trick Animation Logic
  if (currentTrick.value !== 'none') {
    trickProgress.value += 0.04
    if (trickProgress.value >= 1) {
      currentTrick.value = 'none'
      trickRotation.value = 0
      trickJump.value = 0
    } else {
      if (currentTrick.value === 'flip') {
        trickRotation.value = trickProgress.value * 360
      } else if (currentTrick.value === 'jump') {
        trickJump.value = Math.sin(trickProgress.value * Math.PI) * 40
      }
    }
  }

  animationFrameId = requestAnimationFrame(update)
}

function handleMouseMove(e: MouseEvent) {
  lastX = e.clientX
  lastY = e.clientY
}

function changeEmotion() {
  emotion.value = emotions[Math.floor(Math.random() * emotions.length)]
}

onMounted(() => {
  lastX = window.innerWidth / 2
  lastY = window.innerHeight / 2
  posX.value = lastX
  posY.value = lastY

  window.addEventListener('mousemove', handleMouseMove)

  emotionTimer = setInterval(() => {
    if (Math.sqrt(Math.pow(lastX - posX.value, 2) + Math.pow(lastY - posY.value, 2)) < 300) {
      changeEmotion()
    }
  }, 3000 + Math.random() * 3000)

  update()
})

onUnmounted(() => {
  window.removeEventListener('mousemove', handleMouseMove)
  if (animationFrameId) cancelAnimationFrame(animationFrameId)
  if (emotionTimer) clearInterval(emotionTimer)
})
</script>

<template>
  <div
    class="fixed top-0 left-0 pointer-events-none z-[9999]"
    :style="{
      transform: `translate3d(${posX}px, ${posY}px, 0)`,
    }"
  >
    <div
      class="relative transition-transform duration-300 ease-out"
      :style="{
        transform: `translateY(${bob + trickJump}px) rotate(${trickRotation}deg) scale(${scaleX}, ${scaleY})`,
        marginLeft: '-30px',
        marginTop: '-30px'
      }"
    >
      <svg
        width="60"
        height="60"
        viewBox="0 0 40 40"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <!-- Body -->
        <rect x="8" y="12" width="24" height="20" rx="8" fill="#0a1220" stroke="#4db8ff" stroke-width="2" />

        <!-- Eyes -->
        <template v-if="emotion !== 'blink'">
          <circle cx="15" cy="20" r="3" fill="#4db8ff" />
          <circle cx="15" cy="19" r="1" fill="white" opacity="0.6" />
          <circle cx="25" cy="20" r="3" fill="#4db8ff" />
          <circle cx="25" cy="19" r="1" fill="white" opacity="0.6" />

          <circle
            cx="15" cy="20" r="1" fill="white" opacity="0.8"
            :style="{ transform: `translate(${(lastX - posX)/50}px, ${(lastY - posY)/50}px)` }"
          />
          <circle
            cx="25" cy="20" r="1" fill="white" opacity="0.8"
            :style="{ transform: `translate(${(lastX - posX)/50}px, ${(lastY - posY)/50}px)` }"
          />

          <template v-if="emotion === 'angry'">
            <line x1="12" y1="17" x2="17" y2="19" stroke="#4db8ff" stroke-width="1.5" stroke-linecap="round" />
            <line x1="28" y1="17" x2="23" y2="19" stroke="#4db8ff" stroke-width="1.5" stroke-linecap="round" />
          </template>
        </template>
        <template v-else>
          <line x1="13" y1="20" x2="17" y2="20" stroke="#4db8ff" stroke-width="2" stroke-linecap="round" />
          <line x1="23" y1="20" x2="27" y2="20" stroke="#4db8ff" stroke-width="2" stroke-linecap="round" />
        </template>

        <!-- Mouths -->
        <path
          v-if="emotion === 'happy'"
          d="M17 24 Q20 26 23 24"
          stroke="#4db8ff" stroke-width="1.5" stroke-linecap="round"
        />
        <path
          v-if="emotion === 'surprised'"
          d="M19 25 A1 1 0 1 1 21 25 A1 1 0 1 1 19 25"
          stroke="#4db8ff" stroke-width="1.5" fill="none"
        />
        <path
          v-if="emotion === 'excited'"
          d="M16 25 Q20 28 24 25"
          stroke="#4db8ff" stroke-width="1.5" stroke-linecap="round"
        />
        <path
          v-if="emotion === 'angry'"
          d="M17 25 L23 25"
          stroke="#4db8ff" stroke-width="1.5" stroke-linecap="round"
        />
        <path
          v-if="emotion === 'blink'"
          d="M18 25 L22 25"
          stroke="#4db8ff" stroke-width="1" stroke-linecap="round"
        />

        <!-- Antenna -->
        <line x1="20" y1="12" x2="20" y2="6" stroke="#4db8ff" stroke-width="2" />
        <circle cx="20" cy="5" r="2" fill="#4db8ff" />

        <!-- Blush -->
        <circle cx="11" cy="22" r="1" fill="#4db8ff" opacity="0.3" />
        <circle cx="29" cy="22" r="1" fill="#4db8ff" opacity="0.3" />
      </svg>

      <div class="absolute -top-8 left-1/2 -translate-x-1/2 text-[10px] font-mono uppercase tracking-widest text-[#4db8ff] opacity-80 whitespace-nowrap">
        Chester Pet
      </div>
    </div>
  </div>
</template>

<style scoped>
div {
  will-change: transform;
}
</style>
